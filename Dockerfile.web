FROM node:18-bullseye-slim AS deps
WORKDIR /app

RUN apt-get update && rm -rf /var/lib/apt/lists/*

RUN mkdir app ct db psp util web
COPY app/package*.json ./app/
COPY ct/package*.json ./ct/
COPY db/package*.json ./db/
COPY psp/package*.json ./psp/
COPY util/package*.json ./util/
COPY web/package*.json ./web/
COPY package*.json ./

RUN npm ci --ignore-scripts

FROM node:18-bullseye-slim AS build
WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/app/node_modules ./app/node_modules
COPY --from=deps /app/ct/node_modules ./ct/node_modules
COPY --from=deps /app/db/node_modules ./db/node_modules
COPY --from=deps /app/psp/node_modules ./psp/node_modules
COPY --from=deps /app/util/node_modules ./util/node_modules
COPY --from=deps /app/web/node_modules ./web/node_modules
COPY --from=deps /app/package.json ./package.json

COPY ./app ./app
COPY ./ct ./ct
COPY ./db ./db
COPY ./psp ./psp
COPY ./util ./util
COPY ./web ./web

RUN npm run prisma:generate

RUN npm run build

FROM node:18-bullseye-slim AS deploy
ENV NODE_ENV=production
WORKDIR /app

RUN apt-get update &&  rm -rf /var/lib/apt/lists/*

RUN mkdir app ct db psp util web

COPY --from=build /app/app/dist ./app/dist
COPY ./app/package*.json ./app/

COPY --from=build /app/ct/dist ./ct/dist
COPY ./ct/package*.json ./ct/

COPY --from=build /app/db/dist ./db/dist
COPY ./db/package*.json ./db/
COPY db/prisma ./db/prisma

COPY --from=build /app/psp/dist ./psp/dist
COPY ./psp/package*.json ./psp/

COPY --from=build /app/util/dist ./util/dist
COPY ./util/package*.json ./util/

COPY --from=build /app/web/dist ./web/dist
COPY ./web/package*.json ./web/

COPY ./package*.json ./

COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/app/node_modules ./app/node_modules
COPY --from=build /app/ct/node_modules ./ct/node_modules
COPY --from=build /app/db/node_modules ./db/node_modules
COPY --from=build /app/psp/node_modules ./psp/node_modules
COPY --from=build /app/util/node_modules ./util/node_modules
COPY --from=build /app/web/node_modules ./web/node_modules

COPY ./migrate-db-and-start.sh ./migrate-db-and-start.sh
RUN  chmod +x ./migrate-db-and-start.sh

EXPOSE 3000
CMD ["./migrate-db-and-start.sh"]
